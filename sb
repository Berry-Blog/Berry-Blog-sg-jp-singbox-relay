#!/usr/bin/env bash
set -Eeuo pipefail
export LANG=C.UTF-8

REPO_RAW="https://raw.githubusercontent.com/Berry-Blog/Berry-Blog-sg-jp-singbox-relay/main"
SB_VERSION="2026-11-12-multi-exit-1"
CONFIG_DIR="/etc/sing-box"
DATA_FILE="$CONFIG_DIR/relay.json"
CONFIG_FILE="$CONFIG_DIR/config.json"
EXPORT_DIR="$CONFIG_DIR/export"
URI_FILE="$EXPORT_DIR/vless.txt"
CLASH_FILE="$EXPORT_DIR/clash.yaml"
BACKUP_ROOT="/root/sb-relay-backups"
SERVICE_FILE="/etc/init.d/sing-box"
BIN="/usr/local/bin/sing-box"
SUB_ROOT="/var/lib/sb-subscription"
SUB_SERVICE="/etc/init.d/sb-subscription"

info(){ printf '\033[1;36m[信息]\033[0m %s\n' "$*"; }
ok(){ printf '\033[1;32m[成功]\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m[提醒]\033[0m %s\n' "$*" >&2; }
err(){ printf '\033[1;31m[错误]\033[0m %s\n' "$*" >&2; }
die(){ err "$*"; exit 1; }
need_root(){ [[ "$(id -u)" -eq 0 ]] || die "请使用 root 用户运行 sb。"; }
need_data(){ [[ -s "$DATA_FILE" ]] || die "尚未初始化 sing-box，请先运行一键安装程序。"; }
get(){ jq -r --arg k "$1" '.[$k] // empty' "$DATA_FILE"; }
valid_port(){ [[ "$1" =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535)); }
valid_uuid(){ [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; }
valid_short(){ [[ "$1" =~ ^([0-9a-fA-F]{2}){1,8}$ ]]; }
valid_pubkey(){ [[ "$1" =~ ^[A-Za-z0-9_-]{43}$ ]]; }
valid_host(){ [[ -n "$1" && "$1" != *[[:space:]]* && "$1" != *'/'* ]]; }
valid_exit_id(){ [[ "$1" =~ ^[a-z][a-z0-9-]{1,31}$ ]]; }
valid_exit_name(){ [[ -n "$1" && "$1" != *$'\r'* && "$1" != *$'\n'* ]]; }
valid_short_or_empty(){ [[ -z "$1" ]] || valid_short "$1"; }
valid_ss_method(){ case "$1" in 2022-blake3-aes-128-gcm|aes-128-gcm|chacha20-ietf-poly1305) return 0;; *) return 1;; esac; }
yaml_quote(){ jq -nr --arg s "$1" '$s|@json'; }


ask_value(){
  local prompt="$1" default="$2" value
  if [[ -n "$default" ]]; then
    read -r -p "$prompt（默认：$default，回车使用默认值）: " value
    [[ -n "$value" ]] || value="$default"
  else
    read -r -p "$prompt（必填）: " value
  fi
  printf '%s' "$value"
}
ask_port(){
  local prompt="$1" default="$2" value
  while true; do
    value="$(ask_value "$prompt" "$default")"
    if valid_port "$value"; then printf '%s' "$value"; return 0; fi
    warn "端口必须是 1 至 65535 的整数，请重新输入。"
  done
}
ask_plain(){
  local prompt="$1" value
  read -r -p "$prompt（明文输入）: " value
  printf '%s' "$value"
}
find_httpd_binary(){
  local candidate
  for candidate in "$(command -v busybox-extras 2>/dev/null || true)" /bin/busybox-extras /usr/bin/busybox-extras; do
    [[ -n "$candidate" && -x "$candidate" ]] || continue
    if "$candidate" --list 2>/dev/null | grep -qx httpd; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

backup_state(){
  local label="手动备份" stamp dest
  [[ $# -eq 0 ]] || label="$1"
  stamp="$(date -u +%Y%m%d-%H%M%S)"
  dest="$BACKUP_ROOT/$stamp-$label"
  mkdir -p "$dest"
  chmod 700 "$BACKUP_ROOT" "$dest"
  [[ ! -d "$CONFIG_DIR" ]] || cp -a "$CONFIG_DIR" "$dest/"
  [[ ! -f "$SERVICE_FILE" ]] || { mkdir -p "$dest/etc/init.d"; cp -a "$SERVICE_FILE" "$dest/etc/init.d/"; }
  [[ ! -f "$BIN" ]] || { mkdir -p "$dest/usr/local/bin"; cp -a "$BIN" "$dest/usr/local/bin/"; }
  printf '%s\n' "$dest"
}
set_string(){
  local key="$1" value="$2" tmp
  tmp="$(mktemp "$CONFIG_DIR/relay.json.XXXXXX")"
  jq --arg k "$key" --arg v "$value" '.[$k]=$v' "$DATA_FILE" > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$DATA_FILE"
}
set_number(){
  local key="$1" value="$2" tmp
  tmp="$(mktemp "$CONFIG_DIR/relay.json.XXXXXX")"
  jq --arg k "$key" --argjson v "$value" '.[$k]=$v' "$DATA_FILE" > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$DATA_FILE"
}
begin_change(){
  CHANGE_SNAPSHOT="$(backup_state "$1")"
  CHANGE_OLD_DATA="$(mktemp)"
  CHANGE_OLD_CONFIG="$(mktemp)"
  cp -a "$DATA_FILE" "$CHANGE_OLD_DATA"
  [[ ! -f "$CONFIG_FILE" ]] || cp -a "$CONFIG_FILE" "$CHANGE_OLD_CONFIG"
}
rollback_change(){
  err "配置应用失败，正在恢复修改前的参数和配置。"
  cp -a "$CHANGE_OLD_DATA" "$DATA_FILE"
  [[ ! -s "$CHANGE_OLD_CONFIG" ]] || cp -a "$CHANGE_OLD_CONFIG" "$CONFIG_FILE"
  rc-service sing-box restart >/dev/null 2>&1 || true
  rm -f "$CHANGE_OLD_DATA" "$CHANGE_OLD_CONFIG"
}
finish_change(){
  if ! render_apply; then rollback_change; return 1; fi
  if ! rc-service sing-box restart; then rollback_change; return 1; fi
  rm -f "$CHANGE_OLD_DATA" "$CHANGE_OLD_CONFIG"
  write_exports
  ok "配置已更新并重启服务。修改前备份：$CHANGE_SNAPSHOT"
}
ensure_direct_uuid(){
  local uuid
  uuid="$(get direct_uuid)"
  if [[ -z "$uuid" ]]; then
    uuid="$("$BIN" generate uuid)"
    valid_uuid "$uuid" || die "生成新加坡直出 UUID 失败。"
    set_string direct_uuid "$uuid"
  fi
}

render_config(){
  need_data
  ensure_direct_uuid
  jq -n \
    --arg listen "$(get listen_address)" \
    --argjson listen_port "$(get listen_port)" \
    --arg in_uuid "$(get inbound_uuid)" \
    --arg direct_uuid "$(get direct_uuid)" \
    --arg in_private "$(get inbound_private_key)" \
    --arg in_short "$(get inbound_short_id)" \
    --arg in_sni "$(get inbound_sni)" \
    --arg in_handshake "$(get inbound_handshake)" \
    --arg jp_host "$(get jp_host)" \
    --argjson jp_port "$(get jp_port)" \
    --arg jp_uuid "$(get jp_uuid)" \
    --arg jp_public "$(get jp_public_key)" \
    --arg jp_short "$(get jp_short_id)" \
    --arg jp_sni "$(get jp_sni)" \
    --arg ss_method "$(get jp_ss_method)" \
    --arg ss_password "$(get jp_ss_password)" \
    --argjson ss_port "$(get jp_ss_port)" \
    --arg mode "$(get mode)" \
    --argjson extra_exits "$(jq -c '.extra_exits // []' "$DATA_FILE")" '
    {
      log:{level:"warn",timestamp:true},
      inbounds:[{
        type:"vless",
        tag:"sg-reality-in",
        listen:$listen,
        listen_port:$listen_port,
        users:(
          [
            {name:"sg-direct",uuid:$direct_uuid,flow:"xtls-rprx-vision"},
            {name:"sg-via-jp",uuid:$in_uuid,flow:"xtls-rprx-vision"}
          ] + ($extra_exits | map({
            name:("sg-via-" + .id),
            uuid:.client_uuid,
            flow:"xtls-rprx-vision"
          }))
        ),
        tls:{
          enabled:true,
          server_name:$in_sni,
          reality:{
            enabled:true,
            handshake:{server:$in_handshake,server_port:443},
            private_key:$in_private,
            short_id:[$in_short]
          }
        }
      }],
      outbounds:(
        [{type:"direct",tag:"sg-direct-out"}] +
        (if $mode=="reality" then [{
          type:"vless",
          tag:"to-jp-reality",
          server:$jp_host,
          server_port:$jp_port,
          uuid:$jp_uuid,
          flow:"xtls-rprx-vision",
          network:"tcp",
          tls:{
            enabled:true,
            server_name:$jp_sni,
            utls:{enabled:true,fingerprint:"chrome"},
            reality:{enabled:true,public_key:$jp_public,short_id:$jp_short}
          }
        }] else [{
          type:"shadowsocks",
          tag:"to-jp-ss",
          server:$jp_host,
          server_port:$ss_port,
          method:$ss_method,
          password:$ss_password,
          network:"tcp"
        }] end) +
        ($extra_exits | map(
          if .protocol=="reality" then {
            type:"vless",
            tag:("to-extra-" + .id),
            server:.host,
            server_port:.port,
            uuid:.uuid,
            flow:"xtls-rprx-vision",
            network:"tcp",
            tls:{
              enabled:true,
              server_name:.sni,
              utls:{enabled:true,fingerprint:"chrome"},
              reality:{enabled:true,public_key:.public_key,short_id:.short_id}
            }
          } else {
            type:"shadowsocks",
            tag:("to-extra-" + .id),
            server:.host,
            server_port:.port,
            method:.method,
            password:.password,
            network:"tcp"
          } end
        ))
      ),
      route:{
        rules:(
          [{
            inbound:["sg-reality-in"],
            auth_user:["sg-direct"],
            action:"route",
            outbound:"sg-direct-out"
          }] + ($extra_exits | map({
            inbound:["sg-reality-in"],
            auth_user:[("sg-via-" + .id)],
            action:"route",
            outbound:("to-extra-" + .id)
          }))
        ),
        final:(if $mode=="reality" then "to-jp-reality" else "to-jp-ss" end)
      }
    }'
}
render_apply(){
  local tmp
  tmp="$(mktemp "$CONFIG_DIR/config.json.XXXXXX")"
  if ! render_config > "$tmp"; then rm -f "$tmp"; return 1; fi
  chmod 600 "$tmp"
  if ! "$BIN" check -c "$tmp"; then
    rm -f "$tmp"
    err "sing-box 配置校验失败，当前运行配置未被替换。"
    return 1
  fi
  mv -f "$tmp" "$CONFIG_FILE"
}
format_host(){
  if [[ "$1" == *:* && "$1" != \[*\] ]]; then printf '[%s]' "$1"; else printf '%s' "$1"; fi
}
write_vless_links(){
  need_data
  [[ -n "$(get direct_uuid)" ]] || die "请先选择菜单 9 应用节点配置，再生成链接。"
  mkdir -p "$EXPORT_DIR"
  chmod 700 "$EXPORT_DIR"
  local host direct_uri jp_uri extra id client_uuid uri
  host="$(format_host "$(get public_host)")"
  direct_uri="vless://$(get direct_uuid)@$host:$(get public_port)?encryption=none&flow=xtls-rprx-vision&security=reality&sni=$(get inbound_sni)&fp=chrome&pbk=$(get inbound_public_key)&sid=$(get inbound_short_id)&type=tcp&headerType=none#SG-Direct"
  jp_uri="vless://$(get inbound_uuid)@$host:$(get public_port)?encryption=none&flow=xtls-rprx-vision&security=reality&sni=$(get inbound_sni)&fp=chrome&pbk=$(get inbound_public_key)&sid=$(get inbound_short_id)&type=tcp&headerType=none#SG-via-JP"
  {
    printf '%s\n' "$direct_uri"
    printf '%s\n' "$jp_uri"
    while IFS= read -r extra; do
      [[ -n "$extra" ]] || continue
      id="$(jq -r '.id' <<< "$extra")"
      client_uuid="$(jq -r '.client_uuid' <<< "$extra")"
      uri="vless://$client_uuid@$host:$(get public_port)?encryption=none&flow=xtls-rprx-vision&security=reality&sni=$(get inbound_sni)&fp=chrome&pbk=$(get inbound_public_key)&sid=$(get inbound_short_id)&type=tcp&headerType=none#SG-via-$id"
      printf '%s\n' "$uri"
    done < <(jq -c '.extra_exits[]?' "$DATA_FILE")
  } > "$URI_FILE"
  chmod 600 "$URI_FILE"
}
write_clash_yaml(){
  need_data
  [[ -n "$(get direct_uuid)" ]] || die "请先选择菜单 9 应用节点配置，再生成 Clash 配置。"
  mkdir -p "$EXPORT_DIR"
  chmod 700 "$EXPORT_DIR"
  local extra id name label
  {
    cat <<EOF
# sing-box 多出口节点；全部客户端仍连接新加坡 Reality 入口
# 适用于 Clash Meta / Mihomo；仅配置 TCP Reality 节点
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: false

proxies:
  - name: "新加坡直出"
    type: vless
    server: "$(get public_host)"
    port: $(get public_port)
    uuid: "$(get direct_uuid)"
    network: tcp
    tls: true
    udp: false
    flow: xtls-rprx-vision
    servername: "$(get inbound_sni)"
    client-fingerprint: chrome
    reality-opts:
      public-key: "$(get inbound_public_key)"
      short-id: "$(get inbound_short_id)"

  - name: "新加坡-日本 BIGLOBE 家宽"
    type: vless
    server: "$(get public_host)"
    port: $(get public_port)
    uuid: "$(get inbound_uuid)"
    network: tcp
    tls: true
    udp: false
    flow: xtls-rprx-vision
    servername: "$(get inbound_sni)"
    client-fingerprint: chrome
    reality-opts:
      public-key: "$(get inbound_public_key)"
      short-id: "$(get inbound_short_id)"
EOF
    while IFS= read -r extra; do
      [[ -n "$extra" ]] || continue
      id="$(jq -r '.id' <<< "$extra")"
      name="$(jq -r '.name' <<< "$extra")"
      label="$name [$id]"
      printf '\n  - name: %s\n' "$(yaml_quote "$label")"
      cat <<EOF
    type: vless
    server: "$(get public_host)"
    port: $(get public_port)
    uuid: "$(jq -r '.client_uuid' <<< "$extra")"
    network: tcp
    tls: true
    udp: false
    flow: xtls-rprx-vision
    servername: "$(get inbound_sni)"
    client-fingerprint: chrome
    reality-opts:
      public-key: "$(get inbound_public_key)"
      short-id: "$(get inbound_short_id)"
EOF
    done < <(jq -c '.extra_exits[]?' "$DATA_FILE")
    cat <<'EOF'

proxy-groups:
  - name: "节点选择"
    type: select
    proxies:
      - "新加坡直出"
      - "新加坡-日本 BIGLOBE 家宽"
EOF
    while IFS= read -r extra; do
      [[ -n "$extra" ]] || continue
      id="$(jq -r '.id' <<< "$extra")"
      name="$(jq -r '.name' <<< "$extra")"
      printf '      - %s\n' "$(yaml_quote "$name [$id]")"
    done < <(jq -c '.extra_exits[]?' "$DATA_FILE")
    cat <<'EOF'
      - DIRECT

rules:
  - MATCH,节点选择
EOF
  } > "$CLASH_FILE"
  chmod 600 "$CLASH_FILE"
}
sync_subscription_file(){
  local token
  token="$(get sub_token)"
  [[ -n "$token" ]] || return 0
  mkdir -p "$SUB_ROOT/$token"
  chmod 755 "$SUB_ROOT" "$SUB_ROOT/$token"
  printf 'Not Found\n' > "$SUB_ROOT/index.html"
  printf 'Not Found\n' > "$SUB_ROOT/$token/index.html"
  cp -f "$CLASH_FILE" "$SUB_ROOT/$token/clash.yaml"
  chmod 644 "$SUB_ROOT/$token/clash.yaml"
}
write_exports(){
  [[ -n "$(get direct_uuid)" ]] || return 0
  write_vless_links
  write_clash_yaml
  sync_subscription_file
}
show_info(){
  need_data
  printf '\n========== 多出口节点信息 ==========\n'
  printf '原日本模式：%s\n' "$(get mode)"
  printf '新加坡公网入口：%s:%s\n' "$(get public_host)" "$(get public_port)"
  printf '新加坡监听：%s:%s/TCP\n' "$(get listen_address)" "$(get listen_port)"
  printf '节点 A：新加坡直出（UUID：%s）\n' "$(get direct_uuid)"
  printf '节点 B：新加坡中转日本（UUID：%s）\n' "$(get inbound_uuid)"
  printf '日本 BIGLOBE：%s:%s\n' "$(get jp_host)" "$(get jp_port)"
  printf '其他落地机数量：%s\n' "$(jq -r '(.extra_exits // []) | length' "$DATA_FILE")"
  jq -r '.extra_exits[]? | "  \(.name) [\(.id)] 协议：\(.protocol) 目标：\(.host):\(.port) 客户端UUID：\(.client_uuid)"' "$DATA_FILE"
  printf 'Reality SNI：%s\n' "$(get inbound_sni)"
  printf '配置文件：%s\nVLESS 文件：%s\nClash 文件：%s\n\n' "$CONFIG_FILE" "$URI_FILE" "$CLASH_FILE"
}
show_credentials(){
  need_data
  printf '\n========== 完整认证参数（明文，请勿公开） ==========\n'
  printf '\n【新加坡 Reality 入站】\n'
  printf 'SG Direct UUID：%s\n' "$(get direct_uuid)"
  printf 'SG via JP UUID：%s\n' "$(get inbound_uuid)"
  printf 'Reality Private Key：%s\n' "$(get inbound_private_key)"
  printf 'Reality Public Key：%s\n' "$(get inbound_public_key)"
  printf 'Reality Short ID：%s\nReality SNI：%s\n' "$(get inbound_short_id)" "$(get inbound_sni)"
  printf '\n【日本 BIGLOBE Reality 出站】\n'
  printf '日本落地 VLESS UUID：%s\n' "$(get jp_uuid)"
  printf '日本 Reality Public Key：%s\n' "$(get jp_public_key)"
  printf '日本 Reality Short ID：%s\nReality SNI：%s\n' "$(get jp_short_id)" "$(get jp_sni)"
  printf '\n【新增落地机（明文）】\n'
  jq -r '.extra_exits[]? | if .protocol=="reality" then
    "\(.name) [\(.id)]: 客户端UUID=\(.client_uuid), 公网=\(.host):\(.port), 落地UUID=\(.uuid), Reality Public Key=\(.public_key), Short ID=\(.short_id), SNI=\(.sni)"
    else "\(.name) [\(.id)]: 客户端UUID=\(.client_uuid), 公网=\(.host):\(.port), SS方式=\(.method), SS密码=\(.password)" end' "$DATA_FILE"
  printf '\n注意：参数仅在 SSH 终端展示，relay.json 为 root-only（600）。\n\n'
}
show_links(){
  need_data
  [[ -n "$(get direct_uuid)" ]] || die "请先选择菜单 9 应用节点配置。"
  write_exports
  local n=0 uri label index
  printf '\n========== 全部 VLESS 一键导入链接 ==========\n'
  while IFS= read -r uri; do
    ((n+=1))
    case "$n" in
      1) label='新加坡直出（SG-Direct）' ;;
      2) label='日本 BIGLOBE（SG-via-JP）' ;;
      *)
        index="$((n-3))"
        label="$(jq -r --argjson i "$index" '.extra_exits[$i] | "\(.name) [\(.id)]"' "$DATA_FILE")"
        ;;
    esac
    printf '\n【%s】\n%s\n' "$label" "$uri"
  done < "$URI_FILE"
  printf '\n共 %s 条独立节点，均通过新加坡同一 Reality 入口。\n' "$n"
  printf '链接文件：%s\nClash 文件：%s\n\n' "$URI_FILE" "$CLASH_FILE"
}
show_clash(){
  need_data
  [[ -n "$(get direct_uuid)" ]] || die "请先选择菜单 9 应用节点配置。"
  write_exports
  printf 'Clash Meta/Mihomo 配置文件：%s\n' "$CLASH_FILE"
  printf '包含 %s 个 VLESS 节点；下载 YAML 后可在客户端导入。\n' "$(wc -l < "$URI_FILE" | tr -d '[:space:]')"
  printf '注意：文件包含节点认证信息，请勿公开。\n'
}
list_extra_exits(){
  need_data
  printf '\n========== 新增落地机列表 ==========\n'
  jq -r '.extra_exits[]? | "ID=\(.id) | 名称=\(.name) | 协议=\(.protocol) | 目标=\(.host):\(.port) | 客户端UUID=\(.client_uuid)"' "$DATA_FILE"
  [[ "$(jq -r '(.extra_exits // []) | length' "$DATA_FILE")" -gt 0 ]] || warn "目前没有新增落地机，使用菜单 33 添加。"
}
extra_exists(){
  jq -e --arg id "$1" 'any(.extra_exits[]?; .id==$id)' "$DATA_FILE" >/dev/null
}
select_extra_id(){
  local id
  list_extra_exits >&2
  id="$(ask_value '请输入落地机 ID' '')"
  valid_exit_id "$id" || { warn "ID 格式错误。"; return 1; }
  extra_exists "$id" || { warn "未找到此 ID。"; return 1; }
  printf '%s' "$id"
}
prompt_extra_json(){
  local id="$1" old="$2" name protocol host port client_uuid response
  local uuid public_key short_id sni method password
  name="$(ask_value '落地机名称（例如 美国PAV）' "$(jq -r '.name // empty' <<< "$old")")"
  valid_exit_name "$name" || { warn "落地机名称不能为空。"; return 1; }
  protocol="$(jq -r '.protocol // empty' <<< "$old")"
  if [[ -z "$protocol" ]]; then
    protocol="$(ask_value '落地协议（reality 或 ss）' 'reality')"
  else
    warn "保留原协议 $protocol；切换协议请删除后重新添加。"
  fi
  [[ "$protocol" == "reality" || "$protocol" == "ss" ]] || { warn "只支持 reality 和 ss。"; return 1; }
  host="$(ask_value '落地机公网 IP/域名' "$(jq -r '.host // empty' <<< "$old")")"
  valid_host "$host" || { warn "落地机地址不合法。"; return 1; }
  port="$(ask_port '落地机公网 TCP 端口（商家映射端口）' "$(jq -r '.port // 30001' <<< "$old")")"
  client_uuid="$(jq -r '.client_uuid // empty' <<< "$old")"
  if [[ -n "$client_uuid" ]]; then
    read -r -p '是否重新生成该线路的客户端 UUID？[y/N]： ' response
    if [[ "$response" == "y" || "$response" == "Y" ]]; then
      client_uuid="$("$BIN" generate uuid)"
      warn "UUID 已重新生成，旧客户端链接会失效。"
    fi
  else
    client_uuid="$("$BIN" generate uuid)"
  fi
  valid_uuid "$client_uuid" || { warn "生成客户端 UUID 失败。"; return 1; }
  if [[ "$protocol" == "reality" ]]; then
    uuid="$(ask_value '落地端 VLESS UUID（必须与落地机一致）' "$(jq -r '.uuid // empty' <<< "$old")")"
    public_key="$(ask_value '落地端 Reality Public Key' "$(jq -r '.public_key // empty' <<< "$old")")"
    short_id="$(ask_value '落地端 Reality Short ID（可留空）' "$(jq -r '.short_id // empty' <<< "$old")")"
    sni="$(ask_value '落地端 Reality SNI' "$(jq -r '.sni // "addons.mozilla.org"' <<< "$old")")"
    valid_uuid "$uuid" && valid_pubkey "$public_key" && valid_short_or_empty "$short_id" && valid_host "$sni" || { warn "落地端 UUID / Public Key / Short ID / SNI 不合法。"; return 1; }
    jq -n --arg id "$id" --arg name "$name" --arg protocol "$protocol" --arg host "$host" --argjson port "$port" \
      --arg client_uuid "$client_uuid" --arg uuid "$uuid" --arg public_key "$public_key" --arg short_id "$short_id" --arg sni "$sni" '
      {id:$id,name:$name,protocol:$protocol,host:$host,port:$port,client_uuid:$client_uuid,
       uuid:$uuid,public_key:$public_key,short_id:$short_id,sni:$sni}'
  else
    method="$(ask_value '落地端 Shadowsocks 加密方式' "$(jq -r '.method // "2022-blake3-aes-128-gcm"' <<< "$old")")"
    password="$(ask_value '落地端 Shadowsocks 密码（明文）' "$(jq -r '.password // empty' <<< "$old")")"
    valid_ss_method "$method" && [[ -n "$password" ]] || { warn "Shadowsocks 加密方式或密码不合法。"; return 1; }
    jq -n --arg id "$id" --arg name "$name" --arg protocol "$protocol" --arg host "$host" --argjson port "$port" \
      --arg client_uuid "$client_uuid" --arg method "$method" --arg password "$password" '
      {id:$id,name:$name,protocol:$protocol,host:$host,port:$port,client_uuid:$client_uuid,
       method:$method,password:$password}'
  fi
}
save_extra_change(){
