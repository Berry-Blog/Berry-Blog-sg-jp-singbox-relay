    edit) jq --arg id "$id" --argjson e "$entry" '.schema_version=3 | .extra_exits=(.extra_exits | map(if .id==$id then $e else . end))' "$DATA_FILE" > "$tmp" ;;
    remove) jq --arg id "$id" '.schema_version=3 | .extra_exits=(.extra_exits | map(select(.id!=$id)))' "$DATA_FILE" > "$tmp" ;;
