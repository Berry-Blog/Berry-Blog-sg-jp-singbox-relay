  bash -n "$tmp" || { rm -f "$tmp"; die "新脚本语法检查失败，未替换当前版本。"; }
  install -m 0755 "$tmp" /usr/local/bin/sb
  rm -f "$tmp"
  ok "sb 管理脚本更新成功，正在重新载入新版菜单..."
  exec /usr/local/bin/sb
