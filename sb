  finish_change || return 1
  ok "落地机 $id 已修改。"
  show_links
}
remove_extra_exit(){
  need_data
  local id confirm
  id="$(select_extra_id)" || return 0
  read -r -p "确定删除 $id 中转路由及客户端链接？输入 YES： " confirm
  [[ "$confirm" == "YES" ]] || { info "已取消。"; return 0; }
  begin_change "删除-$id-落地机前"
  save_extra_change remove "$id" '{}'
  finish_change || return 1
