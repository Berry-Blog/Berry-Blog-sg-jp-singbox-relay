  id="$(select_extra_id)" || return 0
  old="$(jq -c --arg id "$id" '.extra_exits[] | select(.id==$id)' "$DATA_FILE")"
  entry="$(prompt_extra_json "$id" "$old")" || { warn "修改取消。"; return 0; }
